# Credentials and everything generated from them. This repo is a public
# template: only the *.example.* files are committed.
# See config/README.md and tools/generate-config.mjs.
config/*.json
!config/*.example.json
libs/environment/src/lib/generated/
hosting/.firebaserc
.env
.env.local

# Firebase
.firebase/
hosting/dist/

# Claude Code. `.claude/skills/` and `.claude/settings.json` are shared on purpose;
# `settings.local.json` is per-machine and holds absolute paths to whatever else is
# on that developer's disk — not something a public template should carry.
.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
.nx/migrate-runs