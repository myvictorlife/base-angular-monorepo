{
  "name": "ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:ui-lib"],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "coverageInclude": ["libs/shared/ui/src/**/*.ts"],
        "coverageExclude": [
          "libs/shared/ui/src/**/index.ts",
          "libs/shared/ui/src/**/*.routes.ts",
          "libs/shared/ui/src/**/*.spec.ts"
        ],
        "coverageThresholds": {
          "statements": 85,
          "branches": 90,
          "functions": 85,
          "lines": 80
        }
      }
    }
  }
}
